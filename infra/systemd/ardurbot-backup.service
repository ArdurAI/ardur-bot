[Unit]
Description=Create and verify a Ardur Bot production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/ardurbot/backup.env
ExecStart=/usr/local/sbin/ardurbot-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
