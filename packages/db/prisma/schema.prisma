model UsageRecord {
  /// Null on historical/totals-only rows. Never backfill certainty or request identity.
  requestKey String? @unique
  requestId String?
  attemptId String?
  parentRequestId String?
  counterEpoch String?
  counterMode String?
  lastSequence Int?
  purpose String @default("legacy")
  coverage String @default("partial")
  categoryCoverage Json?
  inputSemantics String @default("unknown")
  reasoningSemantics String @default("unknown")
  logicalInputTokens Int?
  uncachedInputTokens Int?
  cacheReadInputTokens Int?
  cacheWriteInputTokens Int?
  reportedOutputTokens Int?
  reasoningTokens Int?
  /// A snapshot of the admitted pin, not credentials or mutable bot settings.
  runtimePin Json?
  observations RequestUsageObservation[]
  delegationId String?
  rootTaskId String?
  requesterBotId String?
  actingBotId String?
  depth Int @default(0)
  cost Float?
  pricingProvenance Json?
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId        String?
  userId       String
  runId        String?
  run          Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@index([rootTaskId])
  @@index([delegationId])
  @@map("usage_records")
}

