/// Content-free audit survives deletion of its source thread.
model ReviewExecution {
  idempotencyKey String @id
  spaceId String
  botId String
  userId String
  runId String
  threadId String?
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  historyGeneration Int
  evidenceWatermark String
  policyVersion String
  status String
  reason String?
  reviewerPin Json
  proposalIds Json @default("[]")
  tokens Int?
  reservedTokens Int @default(0)
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([spaceId, createdAt])
  @@index([runId, historyGeneration])
  @@map("review_executions")
}

// Human terminal lifecycle metadata only. No input or output is stored here.
model TerminalAudit {
  sequence BigInt @unique @default(autoincrement())
  id String @id @default(cuid())
  actorUserId String
  spaceId String
  computerId String
  botId String
  sessionRef String
  leaseFence Int
  type String
  reason String
  createdAt DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([sessionRef, createdAt])
  @@map("terminal_audit")
}

// Short-lived command/control reservations survive API/worker process boundaries.
model ComputerAdmission {
  id String @id
  computerId String
  kind String
  expiresAt DateTime

  @@index([computerId, expiresAt])
  @@map("computer_admission")
}

