{
  "name": "@ardurbot/desktop",
  "productName": "Ardur Bot",
  "version": "0.1.0-alpha.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm --filter @ardurbot/host-service build && node ../../scripts/desktop-version.mjs && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "pack": "pnpm --filter @ardurbot/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @ardurbot/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @ardurbot/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@ardurbot/contracts": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@ardurbot/ui-tokens": "workspace:*",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "ai.ardur.bot.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      },
      {
        "from": "assets/icon.png",
        "to": "tray.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "tray.ico"
      },
      {
        "from": "../host-service/dist/host-service.cjs",
        "to": "host-service/host-service.cjs"
      },
      {
        "from": "../host-service/dist/native/${os}_${arch}",
        "to": "host-service/native/${os}_${arch}",
        "filter": [
          "koffi.node"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": false,
      "identity": null
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "signExecutable": false
    },
    "linux": {
      "executableName": "ardur-bot",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Ardur Bot maintainers"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ArdurAI",
        "repo": "ardur-bot",
        "releaseType": "prerelease"
      }
    ],
    "artifactName": "ardur-bot-${version}-${os}-${arch}.${ext}",
    "forceCodeSigning": false,
    "protocols": [
      {
        "name": "Ardur Bot integrations",
        "schemes": [
          "ardurbot"
        ]
      }
    ]
  },
  "description": "Persistent bots on computers and models you choose",
  "homepage": "https://github.com/ArdurAI/ardur-bot",
  "author": "Ardur Bot maintainers"
}
