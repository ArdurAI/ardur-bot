{
  "expo": {
    "name": "Ardur",
    "slug": "ardurbot",
    "owner": "inbox-zero",
    "scheme": "ardurbot",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      ["expo-audio", { "enableBackgroundPlayback": false }],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2965EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ardur uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Ardur uses the camera to pair with home or attach a photo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle"
    ],
    "ios": {
      "bundleIdentifier": "ai.ardur.bot",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "../../packages/ui-tokens/assets/ArdurBot.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ardur confirms your presence before an action runs.",
        "NSCameraUsageDescription": "Ardur uses the camera to pair with home or attach a photo.",
        "NSPhotoLibraryUsageDescription": "Ardur uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Ardur connects to a self-hosted Ardur server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ai.ardur.bot",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "projectId": "07f7eb04-45e3-47fe-9374-99a2f991131e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07f7eb04-45e3-47fe-9374-99a2f991131e"
    }
  }
}
